# Пароль входа в админку /admin. Без него админка не открывается вовсе.
ADMIN_PASSWORD=

# Секрет для подписи сессионной куки админки. Любая длинная случайная строка.
ADMIN_SESSION_SECRET=

# Где лежат база и загрузки, когда тома нет. По умолчанию — ./data.
# На Railway не задавайте: путь к тому приложение берёт само из
# RAILWAY_VOLUME_MOUNT_PATH, а значение вне тома игнорируется.
# ARUS_DATA_DIR=/var/lib/arus-domod

# ---------- SEO ----------------------------------------------------------
# Адрес сайта для поисковиков: канонические ссылки, карта сайта, превью.
# Со схемой и без хвостового слеша. Если не задать, берётся адрес Railway
# (RAILWAY_PUBLIC_DOMAIN), и поисковик получит служебный *.up.railway.app.
SITE_URL=https://arusdomod.shop

# Коды подтверждения владения сайтом — из Google Search Console,
# Яндекс Вебмастера и Bing Webmaster Tools (только сам код, без тега).
# GOOGLE_SITE_VERIFICATION=
# YANDEX_VERIFICATION=
# BING_SITE_VERIFICATION=

# IndexNow (оповещение Bing и Яндекса) переменной не требует. Ключ лежит
# в репозитории файлом public/0554b9c29b354197a3a06124d32dd1a4.txt: протокол
# требует, чтобы имя файла дословно совпадало со значением ключа, поэтому
# две настройки в разных местах тут недопустимы. Файл удалять нельзя — его
# содержимое и есть доказательство владения сайтом.
