# Пароль входа в админку /admin. Без него админка не открывается вовсе.
ADMIN_PASSWORD=

# Секрет для подписи сессионной куки админки. Любая длинная случайная строка.
ADMIN_SESSION_SECRET=

# Где лежит база и загрузки. По умолчанию — ./data рядом с проектом.
# ARUS_DATA_DIR=/var/lib/arus-domod

# Демо-заказы для показа панели: месяц истории с живой воронкой статусов.
# ТОЛЬКО для демонстрации — снимите перед передачей клиенту, иначе владелец
# увидит выдуманных покупателей и примет их за настоящих.
# Засеваются один раз, при создании пустой базы.
# ARUS_DEMO_ORDERS=1
