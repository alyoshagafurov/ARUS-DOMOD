# Пароль входа в админку /admin. Без него админка не открывается вовсе.
ADMIN_PASSWORD=

# Секрет для подписи сессионной куки админки. Любая длинная случайная строка.
ADMIN_SESSION_SECRET=

# Где лежит база и загрузки. По умолчанию — ./data рядом с проектом.
# ARUS_DATA_DIR=/var/lib/arus-domod

# ---------- SEO ----------------------------------------------------------
# Адрес сайта для поисковиков: канонические ссылки, карта сайта, превью.
# Пока своего домена нет, Railway подставляет свой адрес сам
# (RAILWAY_PUBLIC_DOMAIN). Купили домен — впишите его сюда.
# SITE_URL=https://arusdomod.tj

# Коды подтверждения владения сайтом — из Google Search Console,
# Яндекс Вебмастера и Bing Webmaster Tools (только сам код, без тега).
# GOOGLE_SITE_VERIFICATION=
# YANDEX_VERIFICATION=
# BING_SITE_VERIFICATION=

# IndexNow: мгновенно сообщает Bing и Яндексу о новых и изменённых товарах.
# Любая строка из латиницы, цифр и дефисов, 8–128 символов.
# INDEXNOW_KEY=arus-domod-2026-xxxxxxxx
